{
  "name": "echospeak-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:learner": "npm run dev --workspace @echospeak/learner",
    "build:learner": "npm run build --workspace @echospeak/learner",
    "dev:admin": "npm run dev --workspace @echospeak/admin",
    "build:admin": "npm run build --workspace @echospeak/admin",
    "lint:admin": "npm run lint --workspace @echospeak/admin",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "fluent-ffmpeg": "^2.1.3",
    "franc": "^6.2.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "srt-parser-2": "^1.2.3",
    "webvtt-parser": "^2.2.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@storybook/addon-a11y": "^10.1.10",
    "@storybook/addon-docs": "^10.1.10",
    "@storybook/addon-onboarding": "^10.1.10",
    "@storybook/addon-vitest": "^10.1.10",
    "@storybook/react-vite": "^10.1.10",
    "@types/node": "^22.14.0",
    "@vitest/browser-playwright": "^4.0.16",
    "@vitest/coverage-v8": "^4.0.16",
    "playwright": "^1.57.0",
    "storybook": "^10.1.10",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.0.16"
  }
}
