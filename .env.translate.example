# ============================================
# 翻译网关配置 (Translation Gateway)
# ============================================

# 默认翻译提供商（可选，系统会自动选择最佳）
# 可选值：tencent, baidu, baidu-llm, google, deepl
TRANSLATION_DEFAULT_PROVIDER=tencent

# 默认翻译策略（可选）
# speed: 速度优先
# quality: 质量优先
# cost: 成本优先
# balanced: 平衡（默认）
TRANSLATION_DEFAULT_STRATEGY=balanced

# --------------------------------------------
# 腾讯云 TMT（推荐）
# --------------------------------------------
# 优势：速度最快（300-600ms），免费额度最多（500万字符/月）
# 申请地址：https://cloud.tencent.com/product/tmt
# 文档：https://cloud.tencent.com/document/product/551

TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# --------------------------------------------
# 百度翻译（推荐）
# --------------------------------------------
# 优势：质量好，成本低（¥49/百万字符），免费额度 5 万字符/月
# 申请地址：https://fanyi-api.baidu.com/
# 文档：https://fanyi-api.baidu.com/doc/21

BAIDU_TRANSLATE_APP_ID=
BAIDU_TRANSLATE_APP_KEY=

# --------------------------------------------
# Google Translate（全球通用）
# --------------------------------------------
# 优势：全球通用，支持语言最多
# 申请地址：https://console.cloud.google.com/apis/library/translate.googleapis.com
# 文档：https://cloud.google.com/translate/docs

GOOGLE_TRANSLATE_API_KEY=

# --------------------------------------------
# DeepL（质量最高）
# --------------------------------------------
# 优势：翻译质量顶级，适合专业文档
# 申请地址：https://www.deepl.com/pro-api
# 文档：https://www.deepl.com/docs-api

DEEPL_API_KEY=
DEEPL_USE_FREE=true  # 是否使用免费版（默认 true）

# ============================================
# 推荐配置
# ============================================
# 
# 1. 最佳性能（速度 + 成本）:
#    - 主力：腾讯云 TMT（速度最快，免费 500 万字符/月）
#    - 备用：百度翻译（质量好，成本低）
#
# 2. 最佳质量:
#    - 主力：百度大模型（AI 理解上下文）
#    - 备用：DeepL（业界公认质量最高）
#
# 3. 全球通用:
#    - 主力：Google Translate（支持语言最多）
#    - 备用：腾讯云 TMT
#
# ============================================
# 性能对比（250 条字幕）
# ============================================
#
# | 服务          | 耗时 | 成本           | 质量        |
# |--------------|------|---------------|-------------|
# | 腾讯云 TMT    | 10s  | 免费 500万/月  | ⭐⭐⭐⭐    |
# | 百度翻译      | 12s  | ¥49/百万       | ⭐⭐⭐⭐    |
# | 百度大模型    | 30s  | ¥0.1/千tokens  | ⭐⭐⭐⭐⭐  |
# | Google       | 15s  | $20/百万       | ⭐⭐⭐⭐    |
# | DeepL        | 18s  | €20/百万       | ⭐⭐⭐⭐⭐  |
# | AI 模型      | 75s  | $0.5-2/百万    | ⭐⭐⭐⭐⭐  |
#
# ============================================
